<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.funny_cats.ui.home.HomeFragment"
        android:label="Главная"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/breedsFragment"
        android:name="com.example.funny_cats.ui.breeds.BreedsFragment"
        android:label="Породы"
        tools:layout="@layout/fragment_breeds" />

    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.example.funny_cats.ui.favorites.FavoritesFragment"
        android:label="Избранное"
        tools:layout="@layout/fragment_favorites" />

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.example.funny_cats.ui.history.HistoryFragment"
        android:label="История"
        tools:layout="@layout/fragment_history" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.funny_cats.ui.settings.SettingsFragment"
        android:label="Настройки"
        tools:layout="@layout/fragment_settings">

        <action
            android:id="@+id/action_settingsFragment_to_notificationsFragment"
            app:destination="@id/notificationsFragment" />

    </fragment>

    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.example.funny_cats.ui.notifications.NotificationsFragment"
        android:label="Уведомления"
        tools:layout="@layout/fragment_notifications" />

    <fragment
        android:id="@+id/imageDetailFragment"
        android:name="com.example.funny_cats.ui.detail.ImageDetailFragment"
        android:label="Детали изображения"
        tools:layout="@layout/fragment_image_detail" />

    <fragment
        android:id="@+id/breedDetailFragment"
        android:name="com.example.funny_cats.ui.breeds.BreedDetailFragment"
        android:label="Детали породы"
        tools:layout="@layout/fragment_breed_detail" />


</navigation>